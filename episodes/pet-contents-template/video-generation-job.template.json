      "allowedModes": ["continuous_handoff", "transition_cut"],
      "continuous_handoff": "previous scene final frame is the next scene start seed",
      "transition_cut": "next scene may use its own approved start frame, but transition type, duration, purpose, and audio/visual bridge must be declared"
    },
    "aspectRatio": "9:16",
    "resolution": "1080x1920",
    "fps": 30,
    "seed": "{{SEED}}",
    "styleLockFile": "storyboard/style-lock.md",
    "compositionRule": "Keep the same cast identity, environment continuity, and emotional direction from the approved storyboard and keyframe plan. Do not generate text in-frame.",
    "negativePromptCommon": "text, letters, subtitles, numbers, logos, watermarks, wrong pet identity, wrong fur color, wrong ear shape, extra limbs, broken anatomy, uncanny faces, threatening wildlife horror tone, gore, blurry"
  },
