{
  "formatVersion": "malmoelab-vnext-episode@0.1",
  "episodeSlug": "{{EPISODE_SLUG}}",
  "seriesSlug": "{{SERIES_SLUG}}",
  "characterSlug": "{{CHARACTER_SLUG}}",
  "characterRoot": "characters/{{CHARACTER_SLUG}}",
  "formatProfile": "malmoelab-keyframe-dub-after-picture-v1",
  "formatProfilePath": "formats/malmoelab-keyframe-dub-after-picture-v1/profile.json",
  "status": "planning",
  "createdAt": "{{ISO8601_TIMESTAMP}}",
  "reusableAssets": {
    "characterImage2D": "characters/{{CHARACTER_SLUG}}/{{CHARACTER_IMAGE_FILE}}",
    "bible": "characters/{{CHARACTER_SLUG}}/bible.md",
    "promptSet": "characters/{{CHARACTER_SLUG}}/prompts.md",
    "voiceConfig": "characters/{{CHARACTER_SLUG}}/voice.json",
    "preferredHandwritingFont": "shared/fonts/NanumSquareRoundB.ttf",
    "preferredStrokeFont": "shared/fonts/NanumGothic-Bold.ttf"
  },
  "lesson": {
    "topicType": "{{TOPIC_TYPE}}",
    "sourceRef": "{{SOURCE_REF}}",
    "sentenceKo": "{{SENTENCE_KO}}",
    "sentenceEn": "{{SENTENCE_EN}}",
    "sentenceRomanized": "{{SENTENCE_ROMANIZED}}",
    "sentenceBlankKo": "{{SENTENCE_BLANK_KO}}",
    "focusWord": "{{FOCUS_WORD}}",
    "serviceCtaKo": "{{SERVICE_CTA_KO}}"
  },
  "renderTargets": {
    "aspectRatio": "16:9",
    "resolution": "1920x1080",
    "fps": 30,
    "durationSec": 30
  },
  "policies": {
    "continuityPolicy": {
      "target": "per-boundary-continuity",
      "sceneDurationSec": 6.0,
      "entryFrameRule": "scene-1 uses approved keyframe-01; each later scene declares a boundaryMode. continuous_handoff uses the previous scene final frame as the next start seed; transition_cut uses its own approved start frame and a transition note.",
      "poseTargetRule": "approved keyframes are the target pose cards for each 6-second clip",
      "contentContinuityFocus": [
        "same-2d-character-identity",
        "same-empty-classroom-board",
        "teacher-on-right-quarter",
        "no-text-in-generated-video",
        "readable-pose-change-per-scene"
      ]
    },
    "audioPolicy": {
      "contentVoiceSourcePriority": [
        "human-dub",
        "actor-dub",
        "voice-pack",
        "supertone-guide",
        "elevenlabs-guide"
      ],
      "contentTtsProvider": "supertone",
      "fallbackTtsProvider": "elevenlabs",
      "generationStage": "mute-video-only",
      "dubStage": "post-picture-lock"
    },
    "textPolicy": {
      "generationStage": "no-text-in-video",
      "typographyStage": "post-dub-lock",
      "chalkStyle": "bold-handwritten-chalk"
    }
  },
  "sourcePacketFile": "./source-packet.json",
  "voiceSlotsFile": "./voice-slots.json",
  "typographySlotsFile": "./typography-slots.json",
  "keyframePlanFile": "./keyframe-plan.json",
  "videoGenerationJobFile": "./video-generation-job.json"
}
