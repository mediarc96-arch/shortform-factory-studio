{
  "_schema": "malmoelab keyframe plan",
  "_note": "003 기준. keyframe 5장을 먼저 잠그고 난 뒤에만 scene video로 넘어간다.",
  "episode": {
    "slug": "{{EPISODE_SLUG}}",
    "basis": "{{CHARACTER_DISPLAY_NAME}} 2D reference -> approved keyframes -> sequential video generation"
  },
  "baseImage": {
    "source": "characters/{{CHARACTER_SLUG}}/{{CHARACTER_IMAGE_FILE}}",
    "refinedWidePath": "assets/refs/{{CHARACTER_SLUG}}-2d-clean-base-wide-refined.png"
  },
  "framingRule": {
    "aspectRatio": "16:9",
    "canvas": [1920, 1080],
    "characterZone": {
      "xPctRange": [73, 100],
      "yPctRange": [0, 100]
    },
    "chalkboardZone": {
      "xPctRange": [0, 73],
      "yPctRange": [5, 90]
    }
  },
  "styleLock": {
    "renderStyle": "2D anime illustration matching the character reference image",
    "avoid": "3D render, photorealistic, text, chalk writing, labels, subtitle artifacts, extra characters"
  },
  "reviewFlow": {
    "gate": "user-review-before-video",
    "reviewBundle": {
      "report": "review/review-report.md",
      "overview": "review/contact-sheets/overview.jpg"
    }
  },
  "keyframes": [
    {
      "id": "kf-01-opening-handoff",
      "anchorSec": 0.0,
      "futureSceneId": "scene-1-opening-handoff",
      "purpose": "opening greeting close",
      "pose": "front-facing, calm warm smile, welcoming host energy",
      "outputPath": "keyframes/kf-01-opening-handoff.jpg"
    },
    {
      "id": "kf-02-lesson-intro",
      "anchorSec": 6.0,
      "futureSceneId": "scene-2-lesson-intro",
      "purpose": "introducing today's sentence",
      "pose": "front-facing, mouth slightly open mid-speech, compact teaching gesture toward board",
      "outputPath": "keyframes/kf-02-lesson-intro.jpg"
    },
    {
      "id": "kf-03-repeat-listen",
      "anchorSec": 12.0,
      "futureSceneId": "scene-3-repeat-listen",
      "purpose": "repeat after me pause",
      "pose": "front-facing, patient smile, attentive listening pose",
      "outputPath": "keyframes/kf-03-repeat-listen.jpg"
    },
    {
      "id": "kf-04-quiz-point",
      "anchorSec": 18.0,
      "futureSceneId": "scene-4-quiz-point",
      "purpose": "blank quiz pointing",
      "pose": "front-facing, playful curious teacher, board-pointing pose",
      "outputPath": "keyframes/kf-04-quiz-point.jpg"
    },
    {
      "id": "kf-05-ending-wave",
      "anchorSec": 24.0,
      "futureSceneId": "scene-5-ending-wave",
      "purpose": "farewell wave",
      "pose": "front-facing, bright smile, small goodbye wave",
      "outputPath": "keyframes/kf-05-ending-wave.jpg"
    }
  ]
}
