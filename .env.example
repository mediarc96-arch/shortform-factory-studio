# Daehan Pilot 001 — 환경변수 예시
#
# 사용법:
#   cp .env.example .env
#   실제 값을 .env에 채움 (.env는 gitignore되어 있음)
#
# 파일럿(로컬 실행):
#   scripts/*.py가 python-dotenv로 .env를 로드
#
# 자동화(Paperclip 에이전트 실행):
#   Paperclip environment 화면에서 같은 키로 값을 입력하고 seal 클릭
#   에이전트 런타임이 실행될 때 os.environ으로 주입됨
#   → 로컬 .env와 Paperclip seal 둘 다 유지 (각각 용도 다름)

# ============================================================
# AI 영상 생성 — Grok
# ============================================================
GROK_API_KEY=
GROK_MODEL=grok-video-latest

# ============================================================
# AI 이미지 생성 — OpenAI GPT Image
# ============================================================
# Paperclip server/company secret이 이 값을 들고 있으면 agent runtime에는 직접 주입하지 않아도 됨.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# ============================================================
# TTS — Supertone (한국어 클론 보이스)
# ============================================================
SUPERTONE_API_KEY=
SUPERTONE_VOICE_ID_DAEHAN=
SUPERTONE_VOICE_ID_SEOLMIN=
# Supertone 계정에 사용자 목소리를 클론 등록한 voice_id

# ============================================================
# TTS — ElevenLabs (파일럿에선 미사용, v1 이후 확장용으로 예약)
# ============================================================
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_DAEHAN=
ELEVENLABS_VOICE_ID_SEOLMIN=
ELEVENLABS_VOICE_ID_EN_FEMALE=

# ============================================================
# malmoelab DB (파일럿에선 미사용, 자동화 v3부터 사용)
# ============================================================
MALMOELAB_DATABASE_URL=

# ============================================================
# YouTube (파일럿에선 미사용, v5부터 사용)
# ============================================================
YOUTUBE_CHANNEL_ID=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
YOUTUBE_DEFAULT_PRIVACY_STATUS=private
YOUTUBE_DEFAULT_CATEGORY_ID=22
YOUTUBE_DISCLOSURE_TEXT=
YOUTUBE_NOTIFY_SUBSCRIBERS=false

# ============================================================
# Paperclip (v6부터 사용, 이슈 end-to-end 자동화)
# ============================================================
PAPERCLIP_BASE_URL=https://pc.devscent.com
PAPERCLIP_API_TOKEN=

# ============================================================
# SFS Console docker compose
# ============================================================
# docker compose up -d --build 실행 시 사용하는 host bind.
# nginx는 기본적으로 http://127.0.0.1:3002 로 프록시하면 됩니다.
SFS_WEB_BIND=127.0.0.1
SFS_WEB_PORT=3002
SFS_API_BIND=127.0.0.1
SFS_API_PORT=8002
SFS_DB_NAME=shortform_factory
SFS_DB_HOST=postgres14
SFS_DB_PORT=5432
SFS_PAPERCLIP_BASE_URL=http://paperclip:3100
SFS_PAPERCLIP_API_TOKEN=
SFS_PAPERCLIP_COMPANY_ID=
SFS_PAPERCLIP_PROJECT_ID=
